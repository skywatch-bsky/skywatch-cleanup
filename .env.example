# AT Protocol / Bluesky
DID=did:plc:your-moderator-did-here
BSKY_HANDLE=your-bot.bsky.social
BSKY_PASSWORD=your-app-password-here

# Ozone Moderation API
OZONE_PDS=oysterling.us-west.host.bsky.network
MOD_DID=did:plc:ozone-moderator-did

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
MODEL=mistral

# Policy Configuration
POLICY_ID=your-policy-id-here
CLAVATA_AUTH_TOKEN=your-clavata-auth-token-here

# Rate Limiting
LABEL_LIMIT=2900000
LABEL_LIMIT_WAIT=300000

# Polling Interval (milliseconds)
AUTOACK_PERIOD=600000

# Logging
LOG_LEVEL=info
NODE_ENV=development
